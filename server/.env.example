# ---- FreeCall server config ----

# HTTP/Socket port
PORT=4000

# Comma-separated list of allowed web origins for CORS (dev defaults shown).
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# Secret used to sign JWTs. CHANGE THIS in production.
JWT_SECRET=dev-super-secret-change-me
JWT_EXPIRES_IN=7d

# ---- STUN/TURN ----
# Public STUN works for many networks. TURN is required for calls that cross
# symmetric NATs / strict firewalls. Get free TURN creds from e.g. metered.ca,
# or run coturn yourself.
STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Web Push (VAPID) ----
# Generate with:  npm run genkeys   (prints a public/private pair)
# Leave empty to disable push (clients degrade gracefully).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@freecall.example
